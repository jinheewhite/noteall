{
  "name": "noteall",
  "version": "1.0.0",
  "private": true,
  "description": "판서노트 + 파워포인트/한글 불러오기 (Windows 데스크톱)",
  "author": "jinheewhite",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "kr.jinheewhite.noteall",
    "productName": "기전판서앱",
    "files": [
      "main.js",
      "preload.js",
      "webview-preload.js",
      "index.html",
      "convert.ps1"
    ],
    "asarUnpack": [
      "convert.ps1"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "kijun_note-Setup.exe",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "jinheewhite",
      "repo": "noteall"
    }
  }
}
